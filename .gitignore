# Виртуальное окружение, кеш Python и метаданные локальной установки.
.venv/
__pycache__/
*.egg-info/
# Результаты запусков и файлы сборки.
results*/
build/
dist/
# Локальные настройки, включая переменные со строкой подключения.
.env
.env.*
# Исходные данные и табличные выгрузки хранятся отдельно от исходного кода.
data/
*.csv
*.csv.gz
*.parquet
